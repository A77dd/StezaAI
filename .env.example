# Telegram interaction layer. Placeholders only: keep real values in a secret manager.

# Bot token issued by the Telegram bot-creation service, format <digits>:<35+ characters>.
TELEGRAM_BOT_TOKEN=
# Bot username without the leading @; must end with "bot".
TELEGRAM_BOT_USERNAME=
# Delivery mode: "webhook" (required in production) or "polling" (local development only).
TELEGRAM_MODE=
# Deployment environment: "development", "test" or "production". Never mix test and production tokens.
TELEGRAM_ENV=
# Secret sent back by Telegram in the webhook header; 1-256 letters, digits, "_" or "-"; must differ from the token.
TELEGRAM_WEBHOOK_SECRET=
# Shared secret protecting scheduled-job endpoints; at least 16 characters; required in production.
TELEGRAM_CRON_SECRET=
# Optional custom Bot API server URL (local server or test double); https in production, localhost only when TELEGRAM_ENV=test.
TELEGRAM_API_ROOT=
# Optional https URL opened by the Mini App launch button.
TELEGRAM_MINI_APP_URL=
